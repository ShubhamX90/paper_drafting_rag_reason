\newlabel{app:deconfound}{{J}{33}{Bounding Factual Grounding}{appendix.J}{}}
\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces \textbf  {The Factual-Grounding denominator is model-dependent.} $\textit  {fg\_n}=608+\textit  {missed refusals}$, so a baseline model that rarely refuses is additionally scored on ${\sim }130$ refusal-required items whose evidence is insufficient by construction, while its false abstentions enter the denominator at $\mathrm  {FG}=0$. The \emph  {like-for-like} columns bound FG on the population where the model answered \emph  {and} the gold label is answerable. A check mark marks cells where the fine-tuned interval lies strictly above the baseline interval: this holds in every minimal-prompt cell and in none of the strict cells.}}{34}{table.25}\protected@file@percent }
\newlabel{tab:fgdenom}{{25}{34}{\textbf {The Factual-Grounding denominator is model-dependent.} $\textit {fg\_n}=608+\textit {missed refusals}$, so a baseline model that rarely refuses is additionally scored on ${\sim }130$ refusal-required items whose evidence is insufficient by construction, while its false abstentions enter the denominator at $\mathrm {FG}=0$. The \emph {like-for-like} columns bound FG on the population where the model answered \emph {and} the gold label is answerable. A check mark marks cells where the fine-tuned interval lies strictly above the baseline interval: this holds in every minimal-prompt cell and in none of the strict cells}{table.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {26}{\ignorespaces \textbf  {Internalization.} Factual Grounding under the minimal prompt, and the spread of CATS-Balanced across the strict/runtime/minimal ladder. Baseline grounding collapses without scaffolding and baseline behaviour swings an order of magnitude more across the ladder.}}{34}{table.26}\protected@file@percent }
\newlabel{tab:internalization}{{26}{34}{\textbf {Internalization.} Factual Grounding under the minimal prompt, and the spread of CATS-Balanced across the strict/runtime/minimal ladder. Baseline grounding collapses without scaffolding and baseline behaviour swings an order of magnitude more across the ladder}{table.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces The Factual-Grounding denominator confound. Left: FG on the like-for-like population, with bars giving the bound and vertical marks the reported value. Crosses mark cells where the intervals overlap and no gap is established. Right: the denominator $\textit  {fg\_n}=608+\textit  {missed refusals}$ is itself model-dependent, so baseline models are scored on up to ${\sim }130$ extra items whose evidence is insufficient by construction.}}{34}{figure.12}\protected@file@percent }
\newlabel{fig:fgdenom}{{12}{34}{The Factual-Grounding denominator confound. Left: FG on the like-for-like population, with bars giving the bound and vertical marks the reported value. Crosses mark cells where the intervals overlap and no gap is established. Right: the denominator $\textit {fg\_n}=608+\textit {missed refusals}$ is itself model-dependent, so baseline models are scored on up to ${\sim }130$ extra items whose evidence is insufficient by construction}{figure.12}{}}
